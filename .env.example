# Copie este arquivo para .env e insira sua chave do OpenRouter.
OPENROUTER_API_KEY=cole_sua_chave_aqui

# Opcional em localhost; obrigatório em produção. Use uma senha aleatória de pelo menos 16 caracteres.
EXION_ACCESS_PASSWORD=troque-por-uma-senha-aleatoria-com-mais-de-16-caracteres

# Modelo compatível com sua conta OpenRouter (por exemplo, openrouter/auto).
OPENROUTER_MODEL=openrouter/auto

# Opcional: informações exibidas ao OpenRouter para identificar seu app.
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=EXION AI

# Opcional: para hospedar em outro endereço/porta.
# HOST=127.0.0.1
# PORT=3000

# Edição de imagens (provedor compatível com endpoint de image edit)
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# Visão + criação/edição com API compatível com OpenAI. A chave fica somente no backend.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4.1-mini

# Motor de IA (openrouter ou gemini)
AI_PROVIDER=openrouter

# Gemini — opcional. Troque AI_PROVIDER para gemini para usar o Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_THINKING_LEVEL=high
GEMINI_ENABLE_SEARCH=true
GEMINI_ENABLE_URL_CONTEXT=true
GEMINI_ENABLE_CODE_EXECUTION=false
GEMINI_STRUCTURED_OUTPUT=false
GEMINI_TEMPERATURE=0.25
GEMINI_MAX_OUTPUT=8192

# EXION Live Voice — áudio em tempo real via Gemini Live
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Orus
GEMINI_LIVE_ENABLED=true
